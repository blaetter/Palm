{
  "name": "palm",
  "private": true,
  "type": "module",
  "description": "Living styleguide of the Palm theme: Storybook renders the Drupal components (SDC) through the storybook module.",
  "scripts": {
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build --output-dir storybook-static",
    "drupal-layer": "node scripts/build-drupal-layer.mjs",
    "style-diff": "node tests/style-diff/style-diff.mjs"
  },
  "devDependencies": {
    "@storybook/server-webpack5": "^10.6.1",
    "playwright-core": "^1.63.0",
    "storybook": "^10.6.1"
  }
}
