{#
/**
 * @file
 * Search form molecule: search field and submit button in one row.
 *
 * Usage: {{ include('palm:search-form', { label: 'Search this website...'|t, button_label: 'search'|t, action: '/search/node' }, with_context = false) }}
 */
#}
{% set input_id = input_id|default('search-form-keys') %}
<form{{ attributes.addClass('palm-search-form').setAttribute('action', action|default('/search/node')).setAttribute('method', 'get') }}>
  <label class="visually-hidden" for="{{ input_id }}">{{ label }}</label>
  {{ include('palm:input', {
    attributes: create_attribute({
      type: 'search',
      id: input_id,
      name: 'keys',
      value: value|default(''),
      placeholder: label,
      class: ['palm-search-form__field'],
    }),
  }, with_context = false) }}
  {{ include('palm:button', {
    label: button_label|default('search'|t),
    button_type: 'submit',
    attributes: create_attribute({ class: ['palm-search-form__submit'] }),
  }, with_context = false) }}
</form>
