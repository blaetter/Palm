{#
/**
 * @file
 * Theme override of blaetter_embed_block.html.twig (blaetter_formatters): the
 * consent button uses palm:button. Keep it in sync with the module template;
 * blaetter_embed.js binds to button.blaetter-embed-consent and uses its parent
 * element as placeholder.
 *
 * Available variables:
 * - embed - The embed array containing all information about the embed.
 *
 * @ingroup themeable
 */
#}
{% if embed.url %}
  {% if 'y' == embed.privacy %}
    <div class="block--white blaetter-embed embed--{{ embed.provider_slug }}"
      data-embedurl="{{ embed.url }}"
      data-title="{{ embed.title }}"
      data-provider="{{ embed.provider }}"
      data-styles="{{ embed.styles }}"
      aria-label="{{ 'Placeholder for embedding content from' |t }} {{ embed.provider }}"
    >
      <p class="text">
    {% trans %}
      This embed displays content from <strong>{{ embed.provider }}</strong> who might be processing your data.
      If you agree with that, you can show the content by clicking on the button below.<br />
      <strong>Hint:</strong> You need to have JavaScript enabled in order to access this content.
    {% endtrans %}
      </p>
      {{ include('palm:button', { label: 'Click here to accept and view the content.'|t, attributes: create_attribute({ class: ['button', 'blaetter-embed-consent'] }) }, with_context = false) }}
    </div>
  {% else %}
    <iframe
      frameborder="0"
      height="auto"
      scrolling="no"
      src="{{ embed.url }}"
      style="width:100%;{{ embed.styles }}"
      title="{{ embed.title }}"
    ></iframe>
  {% endif %}
{% endif %}
